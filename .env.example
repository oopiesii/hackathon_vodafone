# Скопіюйте у .env (він у .gitignore). Секрети в репозиторій не потрапляють.

# --- спільне ---
DATABASE_URL=postgres://ufv:ufv@127.0.0.1:5433/ufv
NATS_URL=nats://127.0.0.1:4222

# --- apps/api ---
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
# Origin, який бачить браузер. У dev це Vite (він проксіює /api на PORT), у проді — домен сайту.
PUBLIC_URL=http://localhost:5173
# openssl rand -base64 48
BETTER_AUTH_SECRET=

# --- encrypted Telegram accounts; the admin UI stores API ID/hash and StringSession ---
# Generate 32 bytes once: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep the SAME key in API and collector. Changing it requires re-encrypting/importing sessions.
TG_SESSION_KEY=
