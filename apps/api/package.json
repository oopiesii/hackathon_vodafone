{
  "name": "@ufv/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "auth:migrate": "tsx --env-file-if-exists=../../.env src/scripts/auth-migrate.ts",
    "auth:create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@ufv/shared": "*",
    "better-auth": "^1.7.5",
    "hono": "^4.13.8",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
